#version 430 core

layout(local_size_x = 64) in;

struct Instance
{
    uint transformID;
    uint meshID;
    uint materialID;
    uint visibilityID;
};

layout(std430, binding = 0) buffer Instances
{
    Instance instances[];
};

layout(std430, binding = 1) buffer Transforms
{
    mat4 transforms[];
};

layout(std430, binding = 2) buffer Meshes
{
    vec4 boundingSpheres[];
};

layout(std430, binding = 3) buffer Visible
{
    Instance visibleInstances[];
};

layout(std430, binding = 4) buffer Counter
{
    uint drawCount;
};

layout(std430, binding = 7) buffer DebugBuffer
{
    vec4 debugColor[]; // per instance
};

uniform mat4 viewProj;

bool sphereInFrustum(vec4 sphere, mat4 mvp)
{
    // world space center
    vec4 center = vec4(sphere.xyz, 1.0);

    vec4 clip = mvp * center;

    float w = clip.w;

    // simple clip-space test
    return (clip.x > -w - sphere.w &&
            clip.x <  w + sphere.w &&
            clip.y > -w - sphere.w &&
            clip.y <  w + sphere.w &&
            clip.z > -w - sphere.w &&
            clip.z <  w + sphere.w);
}
