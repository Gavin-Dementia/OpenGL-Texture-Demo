#version 430 core

layout(local_size_x = 64) in;

struct DrawElementsIndirectCommandBuffer
{
    uint count;
    uint instanceCount;
    uint firstIndex;
    uint baseVertex;
    uint baseInstance;
};

struct Instance
{
    uint transformID;
    uint meshID;
    uint materialID;
    uint visibilityID;
};

// =========================
// Core Buffers (FROM REGISTRY)

layout(std430, binding = 0) buffer ObjectBuffer// optional
{    uint objectData[];  };

layout(std430, binding = 2) buffer MeshBoundsBuffer
{    vec4 boundingSpheres[];  };

layout(std430, binding = 3) buffer InstanceBuffer
{    Instance instances[];  };

layout(std430, binding = 4) buffer DrawBuffer
{    DrawElementsIndirectCommandBuffer commands[];  };

layout(std430, binding = 6) buffer CounterBuffer
{    uint drawCount;  };

layout(std430, binding = 8) buffer VisibilityBuffer
{    uint instanceIndices[];  };

// =========================
// Light buffers
#if 0
layout(std430, binding = 9) buffer DirLightBuffer
{    DirLightGPU dirLight;  };

layout(std430, binding = 10) buffer PointLightBuffer
{    PointLightGPU pointLights[];  };
#endif
// =========================
// Camera

layout(std140, binding = 0) uniform CameraUBO
{
    mat4 view;
    mat4 projection;
    vec4 viewPos;
};


uniform mat4 viewProj;
#if 0
