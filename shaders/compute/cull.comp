void main()
{
    uint id = gl_GlobalInvocationID.x;

    // safety guard
    if (id >= objects.length())
        return;

    uint meshID = objects[id].meshID;

    vec4 sphere = boundingSpheres[meshID];

    bool visible = sphereInFrustum(sphere);

    if (visible)
    {
        uint index = atomicAdd(drawCount, 1);

        commands[index].count = 36;
