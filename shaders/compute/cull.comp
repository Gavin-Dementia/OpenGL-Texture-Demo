bool sphereInFrustum(vec4 sphere, mat4 mvp)
{
    // world space center
    vec4 center = vec4(sphere.xyz, 1.0);

    vec4 clip = mvp * center;

    float w = clip.w;

    // simple clip-space test
    return (clip.x > -w - sphere.w &&
            clip.x <  w + sphere.w &&
            clip.y > -w - sphere.w &&
            clip.y <  w + sphere.w &&
            clip.z > -w - sphere.w &&
            clip.z <  w + sphere.w);
}

void main()
{
    uint id = gl_GlobalInvocationID.x;

    // IMPORTANT: must use real instance count in production
    if (id >= instances.length())
        return;

    // reset per instance fetch
    Instance inst = instances[id];

    uint meshID = inst.meshID;

    // safety
    if (meshID >= boundingSpheres.length())
        return;

    mat4 vp = projection * view;

    vec4 sphere = boundingSpheres[meshID];

    bool visible = sphereInFrustum(sphere, vp);

    if (visible)
    {
        uint drawID = atomicAdd(drawCount, 1);

        commands[drawID].count = 36;          // cube index count
        commands[drawID].instanceCount = 1;
        commands[drawID].firstIndex = 0;
        commands[drawID].baseVertex = 0;
        commands[drawID].baseInstance = id;

        instanceIndices[drawID] = id;
    }
}
#endif
